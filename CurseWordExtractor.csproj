    <None Update="ggml-base.en.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ggml-small.en.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
	  
	  <None Update="vosk-model-en-us-0.22\**\*">
